; Classic list helpers — count, sum, max, reverse, contains.
; Check: xo check examples/algos/list.echo

/ std/io
/ std/str

$ count = (xs) {
    ~ n = 0
    * item : xs {
        ~ n = n + 1
    }
    ^ n
}

$ sum = (xs) {
    ~ acc = 0
    * item : xs {
        ~ acc = acc + item
    }
    ^ acc
}

$ product = (xs) {
    ~ acc = 1
    * item : xs {
        ~ acc = acc * item
    }
    ^ acc
}

; Max of a non-empty list; none if empty.
$ max = (xs) {
    ~ first = |
    ~ best = 0
    * item : xs {
        ? first {
            ~ best = item
            ~ first = _
        }
        : item > best {
            ~ best = item
        }
    }
    ? first {
        ^
    }
    ^ best
}

$ min = (xs) {
    ~ first = |
    ~ best = 0
    * item : xs {
        ? first {
            ~ best = item
            ~ first = _
        }
        : item < best {
            ~ best = item
        }
    }
    ? first {
        ^
    }
    ^ best
}

; True if target appears in xs.
$ contains = (xs, target) {
    * item : xs {
        ? item == target {
            ^ |
        }
    }
    ^ _
}

; Reverse xs in place.
$ reverse = (xs) {
    $ n = count(xs)
    ~ i = 0
    * i < n / 2 {
        $ j = n - 1 - i
        $ t = xs[i]
        ~ xs[i] = xs[j]
        ~ xs[j] = t
        ~ i = i + 1
    }
    ^ xs
}

$ demo = () {
    $ xs = [3, 1, 4, 1, 5, 9]
    io.print(str.from_int(count(xs)))
    io.print(str.from_int(sum(xs)))
    io.print(str.from_int(product([1, 2, 3, 4])))
    | max(xs) {
        $ v {
            io.print(str.from_int(v))
        }
        : {
            io.print("empty")
        }
    }
    | min(xs) {
        $ v {
            io.print(str.from_int(v))
        }
        : {
            io.print("empty")
        }
    }
    io.print(str.from_int(contains(xs, 5)))
    io.print(str.from_int(contains(xs, 7)))

    ~ buf = [1, 2, 3, 4, 5]
    $ rev = reverse(buf)
    * item : rev {
        io.print(str.from_int(item))
    }
    ^ sum(xs)
}

\ demo, count, sum, product, max, min, contains, reverse
