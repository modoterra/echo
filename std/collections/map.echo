; The Echo map collection (`/ std/collections/map`).
; Wraps hash_table. Fluent: map.make().seed(k0, k1). put/get are free (not fluent).
; Suite: xo test std/collections/map.echo (XO_TEST).

/ std/test
/ std/collections/hash_table

% map {
    $ table

    ; Forward seed onto the backing table (in-place keys; same table ref).
    $ seed = (k0, k1) {
        .table.seed(k0, k1)
        ^ .
    }
}

$ make = () {
    ^ map { table: hash_table.make() }
}

$ put = (m, key, value) {
    hash_table.put(m.table, key, value)
    ^ m
}

$ get = (m, key) {
    | hash_table.get(m.table, key) {
        $ v {
            ^ v
        }
        : {
            ^
        }
    }
}

$ from_indexed = (ls) {
    ~ m = make()
    ~ i = 0
    * v : ls {
        put(m, i, v)
        ~ i = i + 1
    }
    ^ m
}

$ hash_key = (m, key) {
    ^ hash_table.hash_key(m.table, key)
}

$ bucket_index = (m, key) {
    ^ hash_table.bucket_index(m.table, key)
}

; --- suite ---

test.it("from_indexed", () {
    $ m = from_indexed([10, 20, 30])
    | get(m, 0) {
        $ v {
            test.eq(v, 10)
        }
        : {
            test.fail("missing 0")
        }
    }
    | get(m, 2) {
        $ v {
            test.eq(v, 30)
        }
        : {
            test.fail("missing 2")
        }
    }
})

test.it("make_put_get", () {
    $ m = make()
    put(m, 7, 42)
    put(m, 8, 99)
    | get(m, 7) {
        $ v {
            test.eq(v, 42)
        }
        : {
            test.fail("missing 7")
        }
    }
    | get(m, 8) {
        $ v {
            test.eq(v, 99)
        }
        : {
            test.fail("missing 8")
        }
    }
    | get(m, 0) {
        $ v {
            test.fail("expected miss")
        }
        : {
            test.eq(1, 1)
        }
    }
})

test.it("put_overwrite", () {
    $ m = make()
    put(m, 1, 10)
    put(m, 1, 20)
    | get(m, 1) {
        $ v {
            test.eq(v, 20)
        }
        : {
            test.fail("missing")
        }
    }
})

test.it("bucket_index_stable", () {
    $ m = make()
    $ a = bucket_index(m, 123)
    $ b = bucket_index(m, 123)
    test.eq(a, b)
    ? a < 0 || a >= hash_table.n_buckets() {
        test.fail("bucket out of range")
    }
})

test.it("fluent_seed", () {
    # K0 = 0x0101010101010101
    # K1 = 0x0202020202020202
    $ m = make().seed(<ui64> K0, <ui64> K1)
    put(m, 3, 9)
    | get(m, 3) {
        $ v {
            test.eq(v, 9)
        }
        : {
            test.fail("missing")
        }
    }
})

\ map, make, put, get, from_indexed, hash_key, bucket_index
