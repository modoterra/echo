; std/collections/hash_table — SipHash-2-4 bucketed key→value table (i64 keys).
; Backing store for map and set. Prefer map / set in app code.
;
; Fluent: hash_table.make().seed(k0, k1) (plain; no empty check — map/set enforce that).
; put/get free (not fluent).
;
; Suite: xo test std/collections/hash_table.echo (XO_TEST).

/ std/test
/ std/crypto/hash
/ std/bytes

# N_BUCKETS = 16
# BUCKET_MASK = 15

# DEFAULT_K0 = 0x0706050403020100
# DEFAULT_K1 = 0x0f0e0d0c0b0a0908

% hash_table {
    ~ buckets = []
    ~ k0 = <ui64> 0
    ~ k1 = <ui64> 0

    ; True if every chain is empty.
    $ is_empty = () {
        * chain : .buckets {
            * e : chain {
                ^ _
            }
        }
        ^ |
    }

    ; Set SipHash key halves (ui64). In-place; returns . for fluent make().seed(…).
    ; Map/set layer refuse reseed when non-empty.
    $ seed = (k0, k1) {
        ~ .k0 = k0
        ~ .k1 = k1
        ^ .
    }
}

% entry {
    $ key
    ~ value
}

$ empty_buckets = () {
    ~ bs = []
    ; Inclusive range: 0..(N-1) → N empty chains.
    * i : 0..(N_BUCKETS - 1) {
        ~ bs[] = []
    }
    ^ bs
}

$ make = () {
    ^ hash_table {
        buckets: empty_buckets(),
        k0: <ui64> DEFAULT_K0,
        k1: <ui64> DEFAULT_K1
    }
}

$ hash_key = (t, key) {
    $ raw = bytes.from_int(key)
    ^ hash.sip(t.k0, t.k1, raw)
}

$ bucket_index = (t, key) {
    $ h = hash_key(t, key)
    ^ <i64> (h & <ui64> BUCKET_MASK)
}

$ n_buckets = () {
    ^ N_BUCKETS
}

$ put = (t, key, value) {
    $ i = bucket_index(t, key)
    $ chain = t.buckets[i]
    * e : chain {
        ? e.key == key {
            ~ e.value = value
            ^ t
        }
    }
    ~ chain[] = entry { key: key, value: value }
    ^ t
}

$ get = (t, key) {
    $ i = bucket_index(t, key)
    $ chain = t.buckets[i]
    * e : chain {
        ? e.key == key {
            ^ e.value
        }
    }
    ^
}

; --- suite ---

test.it("put_get", () {
    $ t = make()
    put(t, 7, 42)
    | get(t, 7) {
        $ v {
            test.eq(v, 42)
        }
        : {
            test.fail("missing")
        }
    }
})

test.it("bucket_stable", () {
    $ t = make()
    $ a = bucket_index(t, 99)
    $ b = bucket_index(t, 99)
    test.eq(a, b)
    ? a < 0 || a >= n_buckets() {
        test.fail("oob bucket")
    }
})

test.it("fluent_seed", () {
    # K0 = 0x1111111111111111
    # K1 = 0x2222222222222222
    $ t = make().seed(<ui64> K0, <ui64> K1)
    test.eq(t.k0, <ui64> K0)
    test.eq(t.k1, <ui64> K1)
    test.true(t.is_empty())
    put(t, 1, 2)
    test.false(t.is_empty())
    | get(t, 1) {
        $ v {
            test.eq(v, 2)
        }
        : {
            test.fail("missing after seed")
        }
    }
})

\ hash_table, entry, make, put, get, hash_key, bucket_index, n_buckets
