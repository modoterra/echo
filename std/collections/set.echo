; The Echo set collection (`/ std/collections/set`).
; Membership over i64 keys, backed by hash_table (dummy value PRESENT).
; Suite: xo test std/collections/set.echo (XO_TEST).

/ std/test
/ std/collections/hash_table

# PRESENT = 1

% set {
    $ table
}

$ make = () {
    ^ set { table: hash_table.make() }
}

$ make_seeded = (k0, k1) {
    ^ set { table: hash_table.make_seeded(k0, k1) }
}

$ add = (s, x) {
    hash_table.put(s.table, x, PRESENT)
    ^ s
}

$ has = (s, x) {
    | hash_table.get(s.table, x) {
        $ present {
            ^ |
        }
        : {
            ^ _
        }
    }
}

$ from_list = (ls) {
    ~ s = make()
    * v : ls {
        add(s, v)
    }
    ^ s
}

; --- suite ---

test.it("add_has", () {
    $ s = make()
    add(s, 7)
    add(s, 8)
    test.true(has(s, 7))
    test.true(has(s, 8))
    test.false(has(s, 0))
})

test.it("add_idempotent", () {
    $ s = make()
    add(s, 1)
    add(s, 1)
    test.true(has(s, 1))
})

test.it("from_list", () {
    $ s = from_list([10, 20, 10, 30])
    test.true(has(s, 10))
    test.true(has(s, 20))
    test.true(has(s, 30))
    test.false(has(s, 40))
})

\ set, make, make_seeded, add, has, from_list
