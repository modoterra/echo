; The Echo set collection (`/ std/collections/set`).
; Backed by hash_table. Fluent: set.make().seed(k0, k1). add/has free (not fluent).
; Suite: xo test std/collections/set.echo (XO_TEST).

/ std/test
/ std/collections/hash_table

# PRESENT = 1

% set {
    $ table

    ; Empty set only. Result-shaped: ^ . or ! msg. (Policy lives here, not on hash_table.)
    $ seed = (k0, k1) {
        ? .table.is_empty() {
            .table.seed(k0, k1)
            ^ .
        }
        ! "cannot reseed non-empty set"
    }
}

$ make = () {
    ^ set { table: hash_table.make() }
}

$ add = (s, x) {
    hash_table.put(s.table, x, PRESENT)
    ^ s
}

$ has = (s, x) {
    | hash_table.get(s.table, x) {
        $ present {
            ^ |
        }
        : {
            ^ _
        }
    }
}

$ from_list = (ls) {
    ~ s = make()
    * v : ls {
        add(s, v)
    }
    ^ s
}

; --- suite ---

test.it("add_has", () {
    $ s = make()
    add(s, 7)
    add(s, 8)
    test.true(has(s, 7))
    test.true(has(s, 8))
    test.false(has(s, 0))
})

test.it("add_idempotent", () {
    $ s = make()
    add(s, 1)
    add(s, 1)
    test.true(has(s, 1))
})

test.it("from_list", () {
    $ s = from_list([10, 20, 10, 30])
    test.true(has(s, 10))
    test.true(has(s, 20))
    test.true(has(s, 30))
    test.false(has(s, 40))
})

test.it("fluent_seed", () {
    # K0 = 0x0303030303030303
    # K1 = 0x0404040404040404
    | make().seed(<ui64> K0, <ui64> K1) {
        $ s {
            add(s, 5)
            test.true(has(s, 5))
            test.false(has(s, 6))
        }
        ! e {
            test.fail(e)
        }
    }
})

test.it("reseed_nonempty_err", () {
    $ s = make()
    add(s, 1)
    | s.seed(<ui64> 1, <ui64> 2) {
        $ ok {
            test.fail("expected reseed error")
        }
        ! e {
            test.eq(e, "cannot reseed non-empty set")
        }
    }
})

\ set, make, add, has, from_list
