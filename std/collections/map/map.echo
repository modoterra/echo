; The Echo map collection
; Suite cases co-located: register under `xo test` only (XO_TEST).

/ std/test

% map {
    ~ entries = []
}

% item {
    $ key
    ~ value
}

$ make = () {
    ^ map {}
}

$ from_indexed = (ls) {
    ~ m = make()
    ~ i = 0
    * v : ls {
        ~ m.entries[] = item { key: i, value: v }
        ~ i = i + 1
    }
    ^ m
}

; --- suite (xo test std/collections/map/map.echo) ---

test.it("from_indexed", () {
    $ m = from_indexed([10, 20, 30])
    test.eq(m.entries[0].key, 0)
    test.eq(m.entries[0].value, 10)
    test.eq(m.entries[2].value, 30)
})

test.it("make", () {
    $ m = make()
    ~ m.entries[] = item { key: 0, value: 1 }
    test.eq(m.entries[0].key, 0)
    test.eq(m.entries[0].value, 1)
})

\ map, item, make, from_indexed
