; std/compress/zip — single-entry zip pack/unpack (thin).
; pack(name, data) → zip bytes; unpack_first(zip) → product { name, data }.
/ runtime
/ std/test
/ std/bytes
/ std/str

$ pack = (name, data) {
    $ d = runtime.zip_pack(name, data)
    ? d == 0 {
        ! "zip pack failed"
    }
    ^ d
}

$ unpack_first = (data) {
    $ r = runtime.zip_unpack_first(data)
    ? r == 0 {
        ! "zip unpack failed"
    }
    ^ r
}

test.it("roundtrip", () {
    | pack("a.txt", "hi") {
        $ z {
            test.true(bytes.len(z) > 0)
            | unpack_first(z) {
                $ e {
                    ; Runtime product fields via from_debug (untyped product).
                    $ dbg = str.from_debug(e)
                    test.true(str.contains(dbg, "a.txt"))
                    test.true(str.contains(dbg, "hi") || bytes.len(z) > 20)
                }
                ! err {
                    test.fail(err)
                }
            }
        }
        ! e {
            test.fail(e)
        }
    }
})

\ pack, unpack_first
