; HTTP package — parse (httparse), dispatch, frame, serve
;
; Serve loop: nonblocking TCP + task spawn per connection (`+ handle_connection(…)`).
; Connections are % conn from std/net.

/ runtime
/ std/test
/ std/str
/ std/bytes
/ std/io
/ std/net/tcp
/ std/net/request
/ std/net/response
/ std/net/server

$ text_response = (status, body) {
    ^ response.response {
        status: status,
        headers: {
            content_type: "text/plain; charset=utf-8"
        },
        body: body
    }
}

$ html_response = (status, body) {
    ^ response.response {
        status: status,
        headers: {
            content_type: "text/html; charset=utf-8"
        },
        body: body
    }
}

$ json_response = (status, body) {
    ^ response.response {
        status: status,
        headers: {
            content_type: "application/json; charset=utf-8"
        },
        body: body
    }
}

$ parse_request = (raw) {
    $ p = runtime.http_parse_request(raw)
    ^ request.request {
        method: p.method,
        path: p.path,
        headers: p.headers,
        body: p.body
    }
}

$ status_reason = (code) {
    ? code == 200 {
        ^ "OK"
    }
    ? code == 201 {
        ^ "Created"
    }
    ? code == 204 {
        ^ "No Content"
    }
    ? code == 400 {
        ^ "Bad Request"
    }
    ? code == 404 {
        ^ "Not Found"
    }
    ? code == 500 {
        ^ "Internal Server Error"
    }
    ^ "OK"
}

$ format_response = (res) {
    $ status = str.from_int(res.status)
    $ reason = status_reason(res.status)
    $ body = res.body
    $ len = str.from_int(str.len(body))
    $ ct = res.headers.content_type
    ^ "HTTP/1.1 {status} {reason}\r\nContent-Type: {ct}\r\nContent-Length: {len}\r\nConnection: close\r\n\r\n{body}"
}

$ dispatch = (routes, req) {
    * route : routes {
        ? route.path == req.path {
            ^ route.handle(req)
        }
    }
    $ path = req.path
    ^ text_response(404, "not found: {path}")
}

; One TCP connection (% conn): accumulate **bytes** until request is complete
; (headers + body up to Content-Length when present), then respond.
; Per-chunk `str.from_bytes` would split UTF-8 and shift Content-Length.
; Free-fn param `c` is monomorphic `% conn` from call sites → methods resolve.
$ handle_connection = (c, routes) {
    ~ raw = b''
    * i : 0..256 {
        $ chunk = c.read(65536)
        ? bytes.len(chunk) == 0 {
            ? bytes.len(raw) == 0 {
                c.close()
                ^
            }
            <
        }
        ~ raw = bytes.cat(raw, chunk)
        ? runtime.http_request_complete(raw) != 0 {
            <
        }
    }
    ? bytes.len(raw) == 0 {
        c.close()
        ^
    }
    $ req = parse_request(raw)
    $ res = dispatch(routes, req)
    $ out = format_response(res)
    c.write(out)
    c.close()
    ^
}

; Infinite accept loop. Each connection is a fire-and-forget task (`+`).
$ serve = (addr, routes) {
    $ lis = tcp.listen(addr)
    ? lis.handle == 0 {
        io.log("http.serve: listen failed")
        ^ server.server {
            addr: addr,
            routes: routes,
            running: _
        }
    }
    io.log("http.serve listening {addr}")
    * {
        $ c = tcp.accept(lis)
        ? c.handle != 0 {
            + handle_connection(c, routes)
        }
    }
    ^ server.server {
        addr: addr,
        routes: routes,
        running: |
    }
}

test.it("e26_body_content_length", () {
    ; Same POST /echo bytes as echo26/run/http/006_body_content_length.
    $ raw = "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhello"
    $ req = parse_request(raw)
    test.eq(req.method, "POST")
    test.eq(req.path, "/echo")
    test.eq(req.body, "hello")
})

; Two TCP-sized chunks that split UTF-8 `é` (U+00E9 = c3 a9).
test.it("parse_split_utf8_chunks", () {
    $ headers = b"POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 2\r\n\r\n"
    $ c1 = bytes.cat(headers, b"\xc3")
    $ raw = bytes.cat(c1, b"\xa9")
    $ req = parse_request(raw)
    test.eq(req.body, "é")
})

; Public API (export discipline — docs/stdlib.md):
;   types; serve; parse/format; response helpers; dispatch + handle_connection
;   (apps may reimplement the accept loop without using serve)
; Private: status_reason (format_response plumbing only)
\ request, response, server
\ text_response, html_response, json_response, parse_request, format_response
\ dispatch, handle_connection, serve
