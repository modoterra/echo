; std/crypto/hash/sip — SipHash-2-4 (Aumasson & Bernstein).
; Folder module `/ std/crypto/hash` → `hash.sip(k0, k1, msg)`.
;
; k0, k1: ui64 key halves (little-endian 128-bit key).
; msg: bytes. Returns ui64 digest.
;
; Public API (export discipline — docs/stdlib.md): \ sip
; Private: sip_state, rotl, sip_round, byte_at, load_le, paper constants, suite.
;
; Width discipline: tag field defaults + paper constants once; untagged lits
; adopt ui64 lanes. Re-tag only at free-fn ABI entry and ui8→ui64 zext.
;
; Suite: paper key 00..0f; co-located `xo test` cases (XO_TEST).

/ std/bytes
/ std/test

# C0 = <ui64> 0x736f6d6570736575
# C1 = <ui64> 0x646f72616e646f6d
# C2 = <ui64> 0x6c7967656e657261
# C3 = <ui64> 0x7465646279746573

% sip_state {
    ~ v0 = <ui64> 0
    ~ v1 = <ui64> 0
    ~ v2 = <ui64> 0
    ~ v3 = <ui64> 0
}

; Free-fn params are universal i64 — re-enter ui64 for logical `>>`.
$ rotl = (x, b) {
    $ xu = <ui64> x
    $ n = <ui64> b & 63
    ? n == 0 {
        ^ xu
    }
    ^ (xu << n) | (xu >> (64 - n))
}

$ sip_round = (s) {
    ~ s.v0 = s.v0 + s.v1
    ~ s.v1 = rotl(s.v1, 13)
    ~ s.v1 = s.v1 ^ s.v0
    ~ s.v0 = rotl(s.v0, 32)

    ~ s.v2 = s.v2 + s.v3
    ~ s.v3 = rotl(s.v3, 16)
    ~ s.v3 = s.v3 ^ s.v2

    ~ s.v0 = s.v0 + s.v3
    ~ s.v3 = rotl(s.v3, 21)
    ~ s.v3 = s.v3 ^ s.v0

    ~ s.v2 = s.v2 + s.v1
    ~ s.v1 = rotl(s.v1, 17)
    ~ s.v1 = s.v1 ^ s.v2
    ~ s.v2 = rotl(s.v2, 32)
    ^ s
}

; Zext byte → ui64 lane (runtime get is not ui8-typed end-to-end for free call).
$ byte_at = (msg, i) {
    | bytes.get(msg, i) {
        $ b {
            ^ <ui64> b
        }
        ! e {
            ^ <ui64> 0
        }
    }
}

$ load_le = (msg, off, end) {
    ~ m = <ui64> 0
    ~ j = 0
    * j < 8 {
        $ idx = off + j
        ? idx < end {
            ~ m = m | (byte_at(msg, idx) << (j * 8))
        }
        ~ j = j + 1
    }
    ^ m
}

$ sip = (k0, k1, msg) {
    ~ s = sip_state {
        v0: C0 ^ k0,
        v1: C1 ^ k1,
        v2: C2 ^ k0,
        v3: C3 ^ k1
    }

    $ n = bytes.len(msg)
    ~ i = 0
    * i + 8 <= n {
        $ m = load_le(msg, i, i + 8)
        ~ s.v3 = s.v3 ^ m
        ~ s = sip_round(s)
        ~ s = sip_round(s)
        ~ s.v0 = s.v0 ^ m
        ~ i = i + 8
    }

    ; len is i64; enter ui64 for the final partial block header.
    ~ b = (<ui64> (n % 256)) << 56
    ~ j = 0
    * i + j < n {
        ~ b = b | (byte_at(msg, i + j) << (j * 8))
        ~ j = j + 1
    }

    ~ s.v3 = s.v3 ^ b
    ~ s = sip_round(s)
    ~ s = sip_round(s)
    ~ s.v0 = s.v0 ^ b

    ~ s.v2 = s.v2 ^ 0xff
    ~ s = sip_round(s)
    ~ s = sip_round(s)
    ~ s = sip_round(s)
    ~ s = sip_round(s)

    ^ s.v0 ^ s.v1 ^ s.v2 ^ s.v3
}

; --- suite ---
; Paper key: 00 01 02 … 0f → k0/k1 little-endian.
; Expected digests keep <ui64> when the high bit is set (untagged hex is i64).

# K0 = <ui64> 0x0706050403020100
# K1 = <ui64> 0x0f0e0d0c0b0a0908

test.it("empty", () {
    $ h = sip(K0, K1, b'')
    test.eq(h, <ui64> 0x726fdb47dd0e0e31)
})

test.it("one_byte", () {
    $ h = sip(K0, K1, b"\x00")
    test.eq(h, <ui64> 0x74f839c593dc67fd)
})

test.it("eight_bytes", () {
    $ msg = b"\x00\x01\x02\x03\x04\x05\x06\x07"
    $ h = sip(K0, K1, msg)
    test.eq(h, <ui64> 0x93f5f5799a932462)
})

test.it("fifteen_bytes", () {
    $ msg = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e"
    $ h = sip(K0, K1, msg)
    test.eq(h, <ui64> 0xa129ca6149be45e5)
})

\ sip
