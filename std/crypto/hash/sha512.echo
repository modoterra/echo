; std/crypto/hash/sha512 — SHA-512 digest of string or bytes → bytes.
/ runtime
/ std/test
/ std/bytes
/ std/encoding/hex

$ sha512 = (data) {
    $ d = runtime.sha512(data)
    ? d == 0 {
        ! "sha512 failed"
    }
    ^ d
}

test.it("sha512_empty", () {
    | sha512("") {
        $ d {
            test.eq(bytes.len(d), 64)
            test.eq(hex.encode(d), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
        }
        ! e {
            test.fail(e)
        }
    }
})

\ sha512
